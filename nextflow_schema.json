{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/nf-core/icgcargomutsig/master/nextflow_schema.json",
    "title": "nf-core/icgcargomutsig pipeline parameters",
    "description": "Mutational signature assignment workflow",
    "type": "object",
    "$defs": {
        "input_output_options": {
            "title": "Input/output options",
            "type": "object",
            "fa_icon": "fas fa-terminal",
            "description": "Define where the pipeline should find input data and save output data.",
            "required": [
                "input",
                "outdir",
                "output_pattern",
                "filetype",
                "context"
            ],
            "properties": {
                "input": {
                    "type": "string",
                    "format": "path",
                    "exists": true,
                    "schema": "assets/schema_input.json",
                    "mimetype": "text/csv",
                    "pattern": ".maf$|.vcf$",
                    "description": "Path to the VCF input data folder or count matrix",
                    "help_text": "You will need to create a design file with information about the samples in your experiment before running the pipeline. Use this parameter to specify its location. It has to be a comma-separated file with 3 columns, and a header row.",
                    "fa_icon": "fas fa-file-csv"
                },
                "outdir": {
                    "type": "string",
                    "format": "directory-path",
                    "description": "The output directory where the results will be saved. You have to use absolute paths to storage on Cloud infrastructure.",
                    "fa_icon": "fas fa-folder-open"
                },
                "output_pattern": {
                    "type": "string",
                    "fa_icon": "fas fa-align-justify",
                    "description": "Output naming convention for the investigated cohort"
                },
                "filetype": {
                    "type": "string",
                    "fa_icon": "fas fa-coins",
                    "description": "Input filetype for analysis"
                },
                "context": {
                    "type": "string",
                    "default": 96,
                    "fa_icon": "fas fa-border-style",
                    "description": "Defines which exposure estimates should be inferred - SBS96, DINUC and/or ID"
                }
            }
        },
        "genomic_references": {
            "title": "Genomic references",
            "type": "object",
            "description": "Define which genomic data should be used for data processing",
            "default": "",
            "properties": {
                "ref": {
                    "type": "string",
                    "fa_icon": "fas fa-dna",
                    "description": "Genomic reference which should be used for mutational signature assignment",
                    "enum": [
                        "GRCh37",
                        "GRCh38"
                    ]
                },
                "exome": {
                    "type": "boolean",
                    "description": "Was the data generated from exome data?",
                    "fa_icon": "fas fa-dna"
                }
            },
            "fa_icon": "fas fa-dna",
            "required": [
                "ref"
            ]
        },
        "signature_assignment_options": {
            "title": "Signature Assignment options",
            "type": "object",
            "description": "Define options used by the implemented signature assignment tools",
            "default": "",
            "fa_icon": "fab fa-deezer",
            "properties": {
                "n_boots": {
                    "type": "integer",
                    "default": 100,
                    "fa_icon": "fab fa-slack-hash",
                    "description": "Number of bootstrap iterations for the fit-function"
                }
            }
        },
        "generic_options": {
            "title": "Generic options",
            "type": "object",
            "fa_icon": "fas fa-file-import",
            "description": "Less common options for the pipeline, typically set in a config file.",
            "help_text": "These options are common to all nf-core pipelines and allow you to customise some of the core preferences for how the pipeline runs.\n\nTypically these options would be set in a Nextflow config file loaded for all pipeline runs, such as `~/.nextflow/config`.",
            "properties": {
                "version": {
                    "type": "boolean",
                    "description": "Display version and exit.",
                    "fa_icon": "fas fa-question-circle",
                    "hidden": true
                },
                "validate_params": {
                    "type": "boolean",
                    "description": "Boolean whether to validate parameters against the schema at runtime",
                    "default": true,
                    "fa_icon": "fas fa-check-square",
                    "hidden": true
                },
                "multiqc_config": {
                    "type": "string",
                    "hidden": true
                },
                "multiqc_title": {
                    "type": "string",
                    "hidden": true
                },
                "multiqc_logo": {
                    "type": "string",
                    "hidden": true
                },
                "max_multiqc_email_size": {
                    "type": "string",
                    "default": "25.MB",
                    "hidden": true
                },
                "multiqc_methods_description": {
                    "type": "string",
                    "hidden": true
                },
                "igenomes_ignore": {
                    "type": "boolean",
                    "default": true,
                    "hidden": true
                },
                "publish_dir_mode": {
                    "type": "string",
                    "default": "copy",
                    "hidden": true
                },
                "email": {
                    "type": "string",
                    "hidden": true
                },
                "email_on_fail": {
                    "type": "string",
                    "hidden": true
                },
                "plaintext_email": {
                    "type": "boolean",
                    "hidden": true
                },
                "monochrome_logs": {
                    "type": "boolean",
                    "hidden": true
                },
                "hook_url": {
                    "type": "string",
                    "hidden": true
                },
                "pipelines_testdata_base_path": {
                    "type": "string",
                    "hidden": true
                },
                "config_profile_name": {
                    "type": "string",
                    "hidden": true
                },
                "config_profile_description": {
                    "type": "string",
                    "hidden": true
                },
                "custom_config_version": {
                    "type": "string",
                    "default": "main",
                    "hidden": true
                },
                "custom_config_base": {
                    "type": "string",
                    "hidden": true
                },
                "config_profile_contact": {
                    "type": "string",
                    "hidden": true
                },
                "config_profile_url": {
                    "type": "string",
                    "hidden": true
                }
            }
        }
    },
    "allOf": [
        {
            "$ref": "#/$defs/input_output_options"
        },
        {
            "$ref": "#/$defs/genomic_references"
        },
        {
            "$ref": "#/$defs/signature_assignment_options"
        },
        {
            "$ref": "#/$defs/generic_options"
        }
    ]
}
